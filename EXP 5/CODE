from collections import deque

def solve():
    q = deque([((3, 3, 0), [])])
    visited = set()

    while q:
        (m, c, b), path = q.popleft()

        if (m, c, b) in visited:
            continue
        visited.add((m, c, b))
        path = path + [(m, c, b)]

        if (m, c, b) == (0, 0, 1):
            for s in path:
                print(s)
            return

        for x, y in [(1,0), (2,0), (0,1), (0,2), (1,1)]:
            nm = m - x if b == 0 else m + x
            nc = c - y if b == 0 else c + y
            nb = 1 - b

            if 0 <= nm <= 3 and 0 <= nc <= 3:
                if (nm == 0 or nm >= nc) and (3-nm == 0 or 3-nm >= 3-nc):
                    q.append(((nm, nc, nb), path))

solve()

